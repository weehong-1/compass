{
  "name": "compass",
  "version": "0.1.0",
  "private": true,
  "description": "风水罗盘：在手机上使用的中国罗盘，二十四山、后天八卦、坐向兼向与空亡提示，支持 iOS 与 Android 指南针",
  "keywords": [
    "luopan",
    "feng-shui",
    "compass",
    "罗盘",
    "风水",
    "nextjs",
    "pwa"
  ],
  "homepage": "https://github.com/weehong-1/compass#readme",
  "bugs": {
    "url": "https://github.com/weehong-1/compass/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weehong-1/compass.git"
  },
  "author": "Wee Hong (https://github.com/weehong-1)",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-sw.mjs",
    "start": "node scripts/serve-out.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "font": "node scripts/subset-font.mjs",
    "icons": "node scripts/make-icons.mjs",
    "e2e": "playwright test",
    "dev:phone": "node scripts/dev-phone.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
